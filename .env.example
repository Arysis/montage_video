# Copie ce fichier en .env et remplis les valeurs. Les lignes marquées [OBLIGATOIRE EN PROD] bloquent le démarrage si elles manquent.

# --- Application ---
APP_URL=http://localhost:3000
APP_NAME=[Nom de l'app]
# [OBLIGATOIRE EN PROD] 32 caractères au moins : openssl rand -base64 48
APP_SECRET=dev-secret-change-me-please
DATABASE_URL=postgres://postgres:postgres@localhost:5432/montage
# Applique les migrations au démarrage du worker (1 = oui)
RUN_MIGRATIONS=1

# --- Stockage des fichiers ---
# local (disque, développement) ou s3 (Cloudflare R2, Scaleway, AWS...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# S3_ENDPOINT=https://<compte>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- IA (script, choix des plans, relecture des images) ---
# anthropic en production, mock pour développer sans clé
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Transcription de la voix ---
STT_PROVIDER=mock
# DEEPGRAM_API_KEY=

# --- Publication sur TikTok, Instagram, YouTube ---
PUBLISH_PROVIDER=mock
# AYRSHARE_API_KEY=
# AYRSHARE_DOMAIN=
# Clé privée Ayrshare (les retours à la ligne peuvent être écrits \n)
# AYRSHARE_PRIVATE_KEY=

# --- E-mails (mot de passe oublié) ---
EMAIL_PROVIDER=log
# RESEND_API_KEY=
EMAIL_FROM=[Nom de l'app] <no-reply@example.com>

# --- Paiement ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_CREATOR=price_...
# Prix affiché sur le site, en euros TTC (exemple : 12)
# CREATOR_PRICE_EUR=

# --- Offres (à décider) ---
FREE_VIDEOS_PER_MONTH=3
CREATOR_VIDEOS_PER_MONTH=30
FREE_MAX_DURATION_SEC=60
CREATOR_MAX_DURATION_SEC=90
FREE_WATERMARK=false

# --- Rendu vidéo ---
MAX_UPLOAD_MB=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FONTS_DIR=assets/fonts
WORK_DIR=.data/work
# Montages en parallèle par worker
RENDER_CONCURRENCY=1

# --- Page d'accueil ---
# NEXT_PUBLIC_DEMO_VIDEO_URL=
# NEXT_PUBLIC_DEMO_POSTER_URL=
# 1 pour afficher les captures de public/captures/*.webp
# NEXT_PUBLIC_SHOW_CAPTURES=0

# Développement et tests uniquement : autorise les services simulés en production
# ALLOW_MOCK_IN_PRODUCTION=0
